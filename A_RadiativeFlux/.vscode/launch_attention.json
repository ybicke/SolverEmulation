        },
        {
            "name": "Debug: Attention Analysis (Module)",
            "type": "debugpy",
            "request": "launch",
            "module": "flux_analysis.analyze_attention",
            "console": "integratedTerminal",
            "python": "/myhome/mambaforge/envs/deepFlux/bin/python",
            "cwd": "${workspaceFolder}/SolverEmulation/A_RadiativeFlux",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/SolverEmulation/A_RadiativeFlux"
            },
            "args": [
                "--model-path", "/path/to/your/best_model.pth",
                "--dataset", "/mydata/deepcloud/salman/dataset/h5_data_all_chuncked", 
                "--save-dir", "/mydata/deepcloud/yves/online-datasets/workspace/results/attention_analysis",
                "--attention-samples", "500"
            ]
        },
        {
            "name": "Debug: Training with Attention Analysis",
