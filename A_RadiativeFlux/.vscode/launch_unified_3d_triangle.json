{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Unified 3D Triangle Training",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/unified_train_flux.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "--model", "gnn_3d",
                "--mode", "3d",
                "--dataset-type", "triangle",
                "--dataset", "/mydata/deepcloud/salman/dataset/h5_data_all_chuncked",
                "--save", "/mydata/deepcloud/yves/A_RadiativeFlux/results/debug_unified_gnn3d_triangle",
                "--percent", "0.01",
                "--subsample", "0.1",
                "--num-workers", "2",
                "--prefetch-factor", "2",
                "--num-cells", "81920",
                "--channel-3d", "6",
                "--channel-2d", "6",
                "--channel-out", "4",
                "--height-in", "70",
                "--triangle-id", "1",
                "--triangle-division-factor", "1",
                "--grid-file-path", "/mydata/deepcloud/yves/SolverEmulation/data_exploration/icon_grid_0008_R02B05_G.nc",
                "--train",
                "--test",
                "--shuffle",
                "--batch-size", "1",
                "--optimizer", "adamw",
                "--clip", "1.0",
                "--num-epoch", "2",
                "--learning-rate", "0.0005",
                "--hidden-dim", "32",
                "--layers", "3",
                "--dropout", "0.0",
                "--edge-channels-in", "1",
                "--no-fully-connected",
                "--no-disable-horizontal",
                "--max-hops", "1",
                "--wandb-mode", "disabled"
            ],
            "justMyCode": true,
            "stopOnEntry": false
        }
    ]
} 